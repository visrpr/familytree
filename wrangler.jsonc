{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "family-tree",
  "main": "worker.js",
  "compatibility_date": "2026-08-24",
  "observability": {
    "enabled": true
  },
  "vars": {
    "GITHUB_OWNER": "visrpr",
    "GITHUB_REPOSITORY": "familytree",
    "GITHUB_BRANCH": "main",
    "GITHUB_PATH": "family-data.js",
    "ALLOWED_ORIGIN": "https://visrpr.github.io"
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "family-tree",
      "database_id": "REPLACE_WITH_D1_DATABASE_ID",
      "migrations_dir": "migrations"
    }
  ],
  "r2_buckets": [
    {
      "binding": "PHOTOS",
      "bucket_name": "family-tree-photos"
    }
  ],
  "secrets": {
    "required": ["IMGBB_API_KEY", "GITHUB_TOKEN", "ADMIN_TOKEN"]
  }
}
