{
	"$schema": "node_modules/wrangler/config-schema.json",
	"name": "family-tree",
	"main": "worker.js",
	"compatibility_date": "2026-08-24",
	"observability": {
		"enabled": true
	},
	"vars": {
		"ALLOWED_ORIGIN": "https://visrpr.github.io",
		"ADMIN_CODE": "kashyap"
	},
	"d1_databases": [
		{
			"binding": "DB",
			"database_name": "family-tree",
			"database_id": "a0b82492-568b-4a0f-becf-63a0bf339c56",
			"migrations_dir": "migrations"
		}
	],
	"r2_buckets": [
		{
			"binding": "PHOTOS",
			"bucket_name": "family-tree-photos"
		}
	]
}